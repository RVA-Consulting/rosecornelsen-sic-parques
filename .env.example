# Copie para .env e ajuste. O .env nunca vai para o GitHub.

# Chave para proteger as sessões de login (gere uma com: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-esta-chave

# Banco: deixe vazio para usar o arquivo local sic.db; no Render, use a URL do Neon
DATABASE_URL=

# Senha dos usuários de teste criados pelo comando "flask --app wsgi seed"
SEED_SENHA=troque-esta-senha

PORT=8000
